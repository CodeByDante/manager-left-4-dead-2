{
  "name": "l4d2-mod-manager",
  "private": true,
  "version": "1.1.1",
  "description": "Aplicación de escritorio para administrar mods y configuraciones de Left 4 Dead 2",
  "author": "CodeByDante",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "npm run check && npm test && electron-builder --win portable --x64",
    "build:exe": "npm run build"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.l4d2.modmanager",
    "productName": "L4D2 Mod Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "L4D2-Mod-Manager-${version}-${arch}.${ext}",
      "icon": "app/assets/icon.ico"
    }
  }
}
